<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Playwright.NUnit" Version="1.62.0" />
    <PackageReference Include="Allure.NUnit" Version="2.15.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <None Update="testsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="allureConfig.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TestData/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareTestArtifacts" BeforeTargets="Build">
    <MakeDir Directories="$(MSBuildThisFileDirectory)../../artifacts/allure-results" />
  </Target>
</Project>
